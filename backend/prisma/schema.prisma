generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int                 @id @default(autoincrement())
  name         String
  biNumber     String
  postalCode   String
  email        String              @unique
  passwordHash String
  role         Role                @default(CIVIL)
  certStatus   CertificationStatus @default(NONE)
  occurrences  Occurrence[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
}

model Occurrence {
  id          Int              @id @default(autoincrement())
  category    String
  description String
  location    String
  status      OccurrenceStatus @default(SUBMETIDA)

  imageUrls   String[]         @default([])

  userId      Int
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([userId])
  @@index([status])
}

enum CertificationStatus {
  NONE
  PENDING
  CERTIFIED
  REJECTED
}

enum OccurrenceStatus {
  SUBMETIDA
  EM_TRATAMENTO
  CONCLUIDA
}

enum Role {
  CIVIL
  OPERADOR
  ADMINISTRADOR
}