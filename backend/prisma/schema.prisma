generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                         Int                         @id @default(autoincrement())
  name                       String
  biNumber                   String
  postalCode                 String
  email                      String                      @unique
  avatarUrl                  String?
  passwordHash               String
  role                       Role                        @default(CIVIL)
  certStatus                 CertificationStatus         @default(NONE)
  occurrences                Occurrence[]
  occurrenceInternalComments OccurrenceInternalComment[]
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
}

model Occurrence {
  id                  Int                @id @default(autoincrement())
  category            OccurrenceCategory
  otherCategoryDetail String?
  description         String
  location            String
  status              OccurrenceStatus   @default(SUBMETIDA)

  imageUrls        String[]                    @default([])
  statusHistory    OccurrenceStatusHistory[]
  internalComments OccurrenceInternalComment[]

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

model OccurrenceStatusHistory {
  id     Int              @id @default(autoincrement())
  status OccurrenceStatus

  occurrenceId Int
  occurrence   Occurrence @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([occurrenceId, createdAt])
}

model OccurrenceInternalComment {
  id      Int    @id @default(autoincrement())
  content String

  occurrenceId Int
  occurrence   Occurrence @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([occurrenceId, createdAt])
  @@index([userId])
}

enum CertificationStatus {
  NONE
  PENDING
  CERTIFIED
  REJECTED
}

enum OccurrenceStatus {
  SUBMETIDA
  EM_TRATAMENTO
  CONCLUIDA
}

enum OccurrenceCategory {
  BURACOS_PAVIMENTO
  ILUMINACAO_PUBLICA
  LIMPEZA_URBANA
  RUIDO
  ESPACOS_PUBLICOS
  SINALIZACAO
  OUTROS
}

enum Role {
  CIVIL
  OPERADOR
  ADMINISTRADOR
}
